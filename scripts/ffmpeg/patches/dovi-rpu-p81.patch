 } DoviRpuContext;
 
+/* TiviBro: profile 7 (UHD Blu-ray, base and enhancement layer) as profile 8.1, the way dovi_tool's
+ * "convert --discard" (mode 2) does: the enhancement layer is dropped, the RPU says there is none
+ * (disable_residual_flag), and its reshaping becomes the identity, so the base layer (HDR10) is shown with
+ * the Dolby Vision dynamic metadata (L1, L2, L5, L6, L8...) kept as it was. */
+static void to_p81(AVDOVIMetadata *m)
+{
+    AVDOVIRpuDataHeader *hdr = (AVDOVIRpuDataHeader *) av_dovi_get_header(m);
+    AVDOVIDataMapping *map = (AVDOVIDataMapping *) av_dovi_get_mapping(m);
+    int max = (1 << hdr->bl_bit_depth) - 1;
+
+    hdr->disable_residual_flag = 1;
+    hdr->el_spatial_resampling_filter_flag = 0;
+    hdr->coef_data_type = 0; /* RPU_COEFF_FIXED: lavc keeps coefficients as fixed point */
+    for (int c = 0; c < 3; c++) {
+        AVDOVIReshapingCurve *cv = &map->curves[c];
+        memset(cv, 0, sizeof(*cv));
+        cv->num_pivots = 2;
+        cv->pivots[0] = 0;
+        cv->pivots[1] = max;
+        cv->mapping_idc[0] = AV_DOVI_MAPPING_POLYNOMIAL;
+        cv->poly_order[0] = 1;
+        cv->poly_coef[0][0] = 0;
+        cv->poly_coef[0][1] = 1LL << hdr->coef_log2_denom;
+    }
+    map->nlq_method_idc = AV_DOVI_NLQ_NONE;
+    map->num_x_partitions = 1;
+    map->num_y_partitions = 1;
+    memset(map->nlq, 0, sizeof(map->nlq));
+    map->nlq_pivots[0] = map->nlq_pivots[1] = 0;
+}
+
 static int update_rpu(AVBSFContext *bsf, const AVPacket *pkt, int flags,
                       const uint8_t *rpu, size_t rpu_size,
                       uint8_t **out_rpu, int *out_size)
@@ -66,6 +98,9 @@
