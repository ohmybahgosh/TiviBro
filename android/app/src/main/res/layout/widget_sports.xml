<?xml version="1.0" encoding="utf-8"?>
<!-- The Sports widget (widget/SportsWidget.kt): a title row (My teams, when it was read, refresh), then the games. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="12dp"
    android:background="@drawable/widget_bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="4dp"
        android:paddingBottom="8dp">
        <!-- Back to the list, shown while a game's inner card is open (in place of the logo). -->
        <ImageView
            android:id="@+id/sw_back"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:padding="6dp"
            android:src="@drawable/ic_arrow_back"
            android:visibility="gone"
            android:contentDescription="Back" />
        <ImageView
            android:id="@+id/sw_logo"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/ic_tile"
            android:importantForAccessibility="no" />
        <TextView
            android:id="@+id/sw_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:paddingStart="8dp"
            android:textColor="#FFFFFFFF"
            android:textSize="16sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="end" />
        <TextView
            android:id="@+id/sw_when"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#FF8A93A8"
            android:textSize="12sp"
            android:paddingEnd="6dp" />
        <ImageView
            android:id="@+id/sw_refresh"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:padding="6dp"
            android:src="@drawable/ic_refresh"
            android:contentDescription="Refresh" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">
        <ListView
            android:id="@+id/sw_list"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:divider="@android:color/transparent"
            android:dividerHeight="6dp" />
        <TextView
            android:id="@+id/sw_empty"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:padding="12dp"
            android:textColor="#FFB8C0D0"
            android:textSize="14sp" />
    </FrameLayout>
</LinearLayout>
