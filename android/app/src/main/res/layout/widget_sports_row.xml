<?xml version="1.0" encoding="utf-8"?>
<!-- A game in the Sports widget's list under the Spotlight (widget/SportsWidgetService.kt): the followed team's logo,
     "Michigan vs Miami" (or the final score), the league and channel, and when. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/swr_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingStart="10dp"
    android:paddingEnd="12dp"
    android:paddingTop="9dp"
    android:paddingBottom="9dp"
    android:background="@drawable/widget_row_bg">
    <ImageView android:id="@+id/swr_logo" android:layout_width="30dp" android:layout_height="30dp" android:importantForAccessibility="no" />
    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:paddingStart="10dp">
        <TextView android:id="@+id/swr_title" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:textColor="#FFFFFFFF" android:textSize="14sp" android:maxLines="1" android:ellipsize="end" />
        <TextView android:id="@+id/swr_sub" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:textColor="#FF8A93A8" android:textSize="11sp" android:maxLines="1" android:ellipsize="end" />
    </LinearLayout>
    <TextView android:id="@+id/swr_when" android:layout_width="wrap_content" android:layout_height="wrap_content" android:paddingStart="8dp"
        android:textColor="#FFB8C0D0" android:textSize="13sp" android:textStyle="bold" android:gravity="end" />
</LinearLayout>
