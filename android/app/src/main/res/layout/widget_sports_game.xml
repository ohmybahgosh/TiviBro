<?xml version="1.0" encoding="utf-8"?>
<!-- The head of a game's inner card in the Sports widget: the Spotlight's look (widget_sports_spot.xml, keep the two
     alike), as its own layout so the list never draws it over a recycled Spotlight of another game. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/sp_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingBottom="12dp"
    android:background="@drawable/widget_spot_bg">

    <LinearLayout android:layout_width="match_parent" android:layout_height="5dp" android:orientation="horizontal"
        android:layout_marginStart="16dp" android:layout_marginEnd="16dp" android:layout_marginTop="12dp">
        <FrameLayout android:id="@+id/sp_stripe_away" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"
            android:layout_marginEnd="2dp" android:background="@drawable/widget_stripe" />
        <FrameLayout android:id="@+id/sp_stripe_home" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"
            android:layout_marginStart="2dp" android:background="@drawable/widget_stripe" />
    </LinearLayout>

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal"
        android:gravity="center_vertical" android:paddingStart="16dp" android:paddingEnd="16dp" android:paddingTop="10dp">
        <TextView android:id="@+id/sp_league" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:textColor="#FFC9D1E3" android:textSize="11sp" android:textStyle="bold" android:letterSpacing="0.08" android:maxLines="1" android:ellipsize="end" />
        <TextView android:id="@+id/sp_pill" android:layout_width="wrap_content" android:layout_height="wrap_content" android:background="@drawable/widget_pill"
            android:paddingStart="9dp" android:paddingEnd="9dp" android:paddingTop="2dp" android:paddingBottom="2dp"
            android:textColor="#FFFFFFFF" android:textSize="11sp" android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal"
        android:gravity="center_vertical" android:paddingStart="8dp" android:paddingEnd="8dp" android:paddingTop="8dp">
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:gravity="center_horizontal">
            <ImageView android:id="@+id/sp_away_logo" android:layout_width="56dp" android:layout_height="56dp" android:importantForAccessibility="no" />
            <TextView android:id="@+id/sp_away_name" android:layout_width="wrap_content" android:layout_height="wrap_content" android:paddingTop="6dp"
                android:textColor="#FFFFFFFF" android:textSize="14sp" android:maxLines="1" android:ellipsize="end" />
        </LinearLayout>
        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center">
            <TextView android:id="@+id/sp_away_score" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textColor="#FFFFFFFF" android:textSize="42sp" android:textStyle="bold" android:fontFeatureSettings="tnum" />
            <TextView android:id="@+id/sp_mid" android:layout_width="wrap_content" android:layout_height="wrap_content" android:paddingStart="8dp" android:paddingEnd="8dp"
                android:textColor="#FF8A93A8" android:textSize="30sp" android:textStyle="bold" />
            <TextView android:id="@+id/sp_home_score" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textColor="#FFFFFFFF" android:textSize="42sp" android:textStyle="bold" android:fontFeatureSettings="tnum" />
        </LinearLayout>
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:gravity="center_horizontal">
            <ImageView android:id="@+id/sp_home_logo" android:layout_width="56dp" android:layout_height="56dp" android:importantForAccessibility="no" />
            <TextView android:id="@+id/sp_home_name" android:layout_width="wrap_content" android:layout_height="wrap_content" android:paddingTop="6dp"
                android:textColor="#FFFFFFFF" android:textSize="14sp" android:maxLines="1" android:ellipsize="end" />
        </LinearLayout>
    </LinearLayout>

    <TextView android:id="@+id/sp_state" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center"
        android:paddingTop="8dp" android:textColor="#FFFF8F8F" android:textSize="13sp" android:textStyle="bold" />
    <TextView android:id="@+id/sp_sit" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center"
        android:paddingTop="2dp" android:textColor="#FFC9D1E3" android:textSize="12sp" android:maxLines="1" android:ellipsize="end" />
    <TextView android:id="@+id/sp_watch" android:layout_width="match_parent" android:layout_height="44dp" android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp" android:layout_marginTop="12dp" android:background="@drawable/widget_watch_bg" android:gravity="center"
        android:textColor="#FFFFFFFF" android:textSize="15sp" android:textStyle="bold" android:maxLines="1" android:ellipsize="end" />
</LinearLayout>
