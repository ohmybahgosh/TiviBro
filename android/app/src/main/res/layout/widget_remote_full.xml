<?xml version="1.0" encoding="utf-8"?>
<!-- The Remote widget at nearly the full page: the tall layout with every button bigger, and the number pad. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@android:id/background" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:gravity="center_horizontal" android:padding="16dp" android:background="@drawable/widget_bg">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
        <ImageView android:id="@+id/rw_power" android:layout_width="44dp" android:layout_height="44dp" android:layout_margin="4dp" android:background="@drawable/remote_round" android:padding="10dp" android:scaleType="fitCenter" android:src="@drawable/ic_power"/>
        <TextView android:id="@+id/rw_name" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:textColor="#FFC9D1E3" android:textSize="14sp" android:textStyle="bold" android:maxLines="1" android:ellipsize="end"/>
        <ImageView android:id="@+id/rw_open" android:layout_width="44dp" android:layout_height="44dp" android:layout_margin="4dp" android:background="@drawable/remote_round" android:padding="11dp" android:scaleType="fitCenter" android:src="@drawable/ic_open_tv"/>
    </LinearLayout>
    <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"/>
    <FrameLayout android:layout_width="212dp" android:layout_height="212dp" android:layout_margin="4dp" android:background="@drawable/remote_ring">
        <TextView android:id="@+id/rw_up" android:layout_width="106dp" android:layout_height="63dp" android:layout_gravity="top|center_horizontal" android:gravity="center" android:text="▲" android:textColor="#FFC9D1E3" android:textSize="16sp"/>
        <TextView android:id="@+id/rw_down" android:layout_width="106dp" android:layout_height="63dp" android:layout_gravity="bottom|center_horizontal" android:gravity="center" android:text="▼" android:textColor="#FFC9D1E3" android:textSize="16sp"/>
        <TextView android:id="@+id/rw_left" android:layout_width="63dp" android:layout_height="106dp" android:layout_gravity="start|center_vertical" android:gravity="center" android:text="◀" android:textColor="#FFC9D1E3" android:textSize="16sp"/>
        <TextView android:id="@+id/rw_right" android:layout_width="63dp" android:layout_height="106dp" android:layout_gravity="end|center_vertical" android:gravity="center" android:text="▶" android:textColor="#FFC9D1E3" android:textSize="16sp"/>
        <TextView android:id="@+id/rw_ok" android:layout_width="89dp" android:layout_height="89dp" android:layout_gravity="center" android:background="@drawable/remote_ok" android:gravity="center" android:text="OK" android:textColor="#FFFFFFFF" android:textSize="23sp" android:textStyle="bold"/>
    </FrameLayout>
    <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="0.6"/>
    <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center">
        <ImageView android:id="@+id/rw_back" android:layout_width="69dp" android:layout_height="49dp" android:layout_margin="4dp" android:background="@drawable/remote_key" android:padding="12dp" android:scaleType="fitCenter" android:src="@drawable/ic_back"/>
        <ImageView android:id="@+id/rw_home" android:layout_width="69dp" android:layout_height="49dp" android:layout_margin="4dp" android:background="@drawable/remote_key" android:padding="12dp" android:scaleType="fitCenter" android:src="@drawable/ic_home"/>
        <ImageView android:id="@+id/rw_menu" android:layout_width="69dp" android:layout_height="49dp" android:layout_margin="4dp" android:background="@drawable/remote_key" android:padding="11dp" android:scaleType="fitCenter" android:src="@drawable/ic_more"/>
        <ImageView android:id="@+id/rw_guide" android:layout_width="69dp" android:layout_height="49dp" android:layout_margin="4dp" android:background="@drawable/remote_key" android:padding="12dp" android:scaleType="fitCenter" android:src="@drawable/ic_guide"/>
    </LinearLayout>
    <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="0.6"/>
    <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center">
        <LinearLayout android:layout_width="73dp" android:layout_height="168dp" android:layout_margin="4dp" android:orientation="vertical" android:background="@drawable/remote_rocker">
            <TextView android:id="@+id/rw_volup" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:gravity="center" android:text="+" android:textColor="#FFFFFFFF" android:textSize="24sp"/>
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:text="VOL" android:textColor="#FFC9D1E3" android:textSize="12sp" android:textStyle="bold" android:letterSpacing="0.06" android:importantForAccessibility="no"/>
            <TextView android:id="@+id/rw_voldown" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:gravity="center" android:text="−" android:textColor="#FFFFFFFF" android:textSize="24sp"/>
        </LinearLayout>
        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="center" android:layout_marginStart="15dp" android:layout_marginEnd="15dp">
            <ImageView android:id="@+id/rw_mute" android:layout_width="69dp" android:layout_height="49dp" android:layout_margin="4dp" android:background="@drawable/remote_round" android:padding="12dp" android:scaleType="fitCenter" android:src="@drawable/ic_mute"/>
            <ImageView android:id="@+id/rw_info" android:layout_width="69dp" android:layout_height="49dp" android:layout_margin="4dp" android:background="@drawable/remote_round" android:padding="12dp" android:scaleType="fitCenter" android:src="@drawable/ic_info"/>
        </LinearLayout>
        <LinearLayout android:layout_width="73dp" android:layout_height="168dp" android:layout_margin="4dp" android:orientation="vertical" android:background="@drawable/remote_rocker">
            <TextView android:id="@+id/rw_chup" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:gravity="center" android:text="∧" android:textColor="#FFFFFFFF" android:textSize="24sp"/>
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:text="CH" android:textColor="#FFC9D1E3" android:textSize="12sp" android:textStyle="bold" android:letterSpacing="0.06" android:importantForAccessibility="no"/>
            <TextView android:id="@+id/rw_chdown" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:gravity="center" android:text="∨" android:textColor="#FFFFFFFF" android:textSize="24sp"/>
        </LinearLayout>
    </LinearLayout>
    <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="0.6"/>
    <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center">
        <TextView android:id="@+id/rw_n1" android:layout_width="71dp" android:layout_height="44dp" android:layout_margin="4dp" android:background="@drawable/remote_key" android:gravity="center" android:text="1" android:textColor="#FFFFFFFF" android:textSize="20sp" android:textStyle="bold"/>
        <TextView android:id="@+id/rw_n2" android:layout_width="71dp" android:layout_height="44dp" android:layout_margin="4dp" android:background="@drawable/remote_key" android:gravity="center" android:text="2" android:textColor="#FFFFFFFF" android:textSize="20sp" android:textStyle="bold"/>
        <TextView android:id="@+id/rw_n3" android:layout_width="71dp" android:layout_height="44dp" android:layout_margin="4dp" android:background="@drawable/remote_key" android:gravity="center" android:text="3" android:textColor="#FFFFFFFF" android:textSize="20sp" android:textStyle="bold"/>
    </LinearLayout>
    <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center">
        <TextView android:id="@+id/rw_n4" android:layout_width="71dp" android:layout_height="44dp" android:layout_margin="4dp" android:background="@drawable/remote_key" android:gravity="center" android:text="4" android:textColor="#FFFFFFFF" android:textSize="20sp" android:textStyle="bold"/>
        <TextView android:id="@+id/rw_n5" android:layout_width="71dp" android:layout_height="44dp" android:layout_margin="4dp" android:background="@drawable/remote_key" android:gravity="center" android:text="5" android:textColor="#FFFFFFFF" android:textSize="20sp" android:textStyle="bold"/>
        <TextView android:id="@+id/rw_n6" android:layout_width="71dp" android:layout_height="44dp" android:layout_margin="4dp" android:background="@drawable/remote_key" android:gravity="center" android:text="6" android:textColor="#FFFFFFFF" android:textSize="20sp" android:textStyle="bold"/>
    </LinearLayout>
    <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center">
        <TextView android:id="@+id/rw_n7" android:layout_width="71dp" android:layout_height="44dp" android:layout_margin="4dp" android:background="@drawable/remote_key" android:gravity="center" android:text="7" android:textColor="#FFFFFFFF" android:textSize="20sp" android:textStyle="bold"/>
        <TextView android:id="@+id/rw_n8" android:layout_width="71dp" android:layout_height="44dp" android:layout_margin="4dp" android:background="@drawable/remote_key" android:gravity="center" android:text="8" android:textColor="#FFFFFFFF" android:textSize="20sp" android:textStyle="bold"/>
        <TextView android:id="@+id/rw_n9" android:layout_width="71dp" android:layout_height="44dp" android:layout_margin="4dp" android:background="@drawable/remote_key" android:gravity="center" android:text="9" android:textColor="#FFFFFFFF" android:textSize="20sp" android:textStyle="bold"/>
    </LinearLayout>
    <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center">
        <FrameLayout android:layout_width="71dp" android:layout_height="44dp" android:layout_margin="4dp"/>
        <TextView android:id="@+id/rw_n0" android:layout_width="71dp" android:layout_height="44dp" android:layout_margin="4dp" android:background="@drawable/remote_key" android:gravity="center" android:text="0" android:textColor="#FFFFFFFF" android:textSize="20sp" android:textStyle="bold"/>
        <FrameLayout android:layout_width="71dp" android:layout_height="44dp" android:layout_margin="4dp"/>
    </LinearLayout>
    <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="0.6"/>
    <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center">
        <ImageView android:id="@+id/rw_rew" android:layout_width="69dp" android:layout_height="44dp" android:layout_margin="4dp" android:background="@drawable/remote_key" android:padding="11dp" android:scaleType="fitCenter" android:src="@drawable/ic_rew"/>
        <ImageView android:id="@+id/rw_play" android:layout_width="89dp" android:layout_height="44dp" android:layout_margin="4dp" android:background="@drawable/remote_key" android:padding="11dp" android:scaleType="fitCenter" android:src="@drawable/ic_play_pause"/>
        <ImageView android:id="@+id/rw_ff" android:layout_width="69dp" android:layout_height="44dp" android:layout_margin="4dp" android:background="@drawable/remote_key" android:padding="11dp" android:scaleType="fitCenter" android:src="@drawable/ic_ff"/>
    </LinearLayout>
    <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="0.4"/>
    <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center">
        <TextView android:id="@+id/rw_red" android:layout_width="62dp" android:layout_height="15dp" android:layout_margin="4dp" android:background="@drawable/remote_red" android:gravity="center" android:text="" android:textColor="#FFFFFFFF" android:textSize="12sp" android:textStyle="bold"/>
        <TextView android:id="@+id/rw_green" android:layout_width="62dp" android:layout_height="15dp" android:layout_margin="4dp" android:background="@drawable/remote_green" android:gravity="center" android:text="" android:textColor="#FFFFFFFF" android:textSize="12sp" android:textStyle="bold"/>
        <TextView android:id="@+id/rw_yellow" android:layout_width="62dp" android:layout_height="15dp" android:layout_margin="4dp" android:background="@drawable/remote_yellow" android:gravity="center" android:text="" android:textColor="#FFFFFFFF" android:textSize="12sp" android:textStyle="bold"/>
        <TextView android:id="@+id/rw_blue" android:layout_width="62dp" android:layout_height="15dp" android:layout_margin="4dp" android:background="@drawable/remote_blue" android:gravity="center" android:text="" android:textColor="#FFFFFFFF" android:textSize="12sp" android:textStyle="bold"/>
    </LinearLayout>
</LinearLayout>
